# THIS FILE IS COMMITTED TO GIT: keep every value below EMPTY.
# Copy it to .env (copy .env.example .env) and put your real keys in .env, which is git-ignored.
# The app reads .env only; editing this file does nothing except risk leaking secrets.
# On Vercel, add the same names under Project Settings > Environment Variables.

# --- Resend ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_DOMAIN=rtcrackers.com

# --- Supabase ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SYNC_BUDGET_SECONDS=45

# --- Portal access (optional) ---
# Only this account can sign in to the portal. Defaults to admin@<MAIL_DOMAIN>.
MAIL_ADMIN_EMAIL=
# Local development only: skip login entirely. Ignored when running on Vercel.
MAIL_DEV_NO_AUTH=

# Production order email settings
ORDER_FROM_EMAIL=RT Crackers <orders@rtcrackers.com>
ORDER_SITE_URL=https://your-cart-domain.example
ADMIN_SITE_URL=https://your-admin-domain.example
